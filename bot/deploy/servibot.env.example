# Servi.pe bot settings. File lives at /etc/servibot/servibot.env (only root can read it).
# After editing: systemctl restart servibot

# From Meta (developers.facebook.com > Servi.pe Bot)
WA_TOKEN=
WA_APP_SECRET=
WA_PHONE_ID=1426759753848412
WA_APP_ID=2199185970645186
WA_WABA_ID=4213388552284876
WA_VERIFY_TOKEN=

# Google Sheets bridge (Apps Script web app URL and its shared secret)
SHEETS_URL=
SHEETS_SECRET=

# Who gets alerts and can approve profiles (international format, no +)
ADMIN_NUMBER=51981571118
# Admin WhatsApp username ID (PE.123...), shown in the log when the admin has a WhatsApp username
ADMIN_USER_ID=
ADMIN_TEMPLATE=aviso_equipo
WORKER_TEMPLATE=seguimiento_perfil
TEMPLATE_LANG=es

DATA_DIR=/var/lib/servibot
PUBLIC_BASE_URL=
